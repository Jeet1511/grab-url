# ── Backend Configuration ──────────────────────────────────────
APP_ID=my-url-resolver
APP_SECRET=change-this-to-a-secure-random-string

# ── Database (Optional - not required for core URL resolver) ───
# DATABASE_URL=mysql://user:password@host:3306/database

# ── Resolver Settings (Optional - defaults shown) ──────────────
# Chromium browser path (auto-detected if not set)
# URL_UNWRAPPER_CHROMIUM_PATH=/usr/bin/chromium

# Timeout settings (milliseconds)
# UNWRAP_TOTAL_TIMEOUT_MS=45000
# UNWRAP_NAV_SETTLE_MS=8000
# UNWRAP_COUNTDOWN_WAIT_MS=20000

# Limits
# UNWRAP_MAX_NAVIGATIONS=20
# UNWRAP_MAX_POPUPS=10
# MAX_CONCURRENT_JOBS=1
